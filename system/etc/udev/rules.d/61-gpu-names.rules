# Stable name for the AMD iGPU card. card0/card1 numbers can change between boots.
# The rule matches the driver, not a PCI address, so it works on other machines with one AMD GPU.
# Users: Hyprland (AQ_DRM_DEVICES in shell/profile-gpu.sh) and the login screen (greetd/config.toml).
KERNEL=="card*", SUBSYSTEM=="drm", DRIVERS=="amdgpu", SYMLINK+="dri/amd-igpu"
