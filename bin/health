#!/bin/bash
# Quick system health check. Prints one line per check: OK or WARN.
# A check runs only when its part is on this machine (NVIDIA driver, Ollama, GRUB, grub-btrfs, a git upstream).
#   health           print all checks
#   health --notify  print, and send one notification if anything is wrong
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
problems=()
ok()   { echo "OK    $1"; }
warn() { echo "WARN  $1"; problems+=("$1"); }

failed=$(systemctl --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')
[ -z "$failed" ] && ok "no failed system services" || warn "failed system services: $failed"
failed=$(systemctl --user --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')
[ -z "$failed" ] && ok "no failed user services" || warn "failed user services: $failed"

has() { pacman -Qq "$1" >/dev/null 2>&1; }

if has nvidia-utils; then
    lspci -d 10de: | grep -qi vga && ok "NVIDIA GPU present" || warn "NVIDIA GPU missing (do a full shutdown, not a restart)"
fi

if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    errors=$(hyprctl configerrors | grep -v '^$')
    # The running Hyprland can be older than the one on disk (after an update): check with the new one too
    Hyprland --verify-config >/dev/null 2>&1 || errors+=" (Hyprland --verify-config: the installed version finds errors)"
    [ -z "$errors" ] && ok "Hyprland config has no errors" || warn "Hyprland config errors: $errors"
    hyprctl plugin list 2>/dev/null | grep -q hyprbars && ok "title bars plugin loaded" \
        || warn "title bars plugin not loaded (run: hyprpm update, then log out and in)"
fi

used=$(df --output=pcent / | tail -1 | tr -dc 0-9)
[ "$used" -lt 85 ] && ok "disk / ${used}% used" || warn "disk / is ${used}% full"

# Claude Code updates itself, outside pacman: check that it still knows the flags of the companion hand-off
if [ -f "$REPO/companion/handoff.py" ] && command -v claude >/dev/null; then
    probe=$(python3 -c "import sys; sys.path.insert(0, '$REPO/companion'); import handoff; from runner import Runner
r = handoff.flags_ok(Runner()); print(r.text); sys.exit(0 if r.ok else 1)" 2>&1) \
        && ok "Claude Code knows the hand-off flags" || warn "Claude Code changed its flags (companion hand-off): $probe"
fi

if command -v ollama >/dev/null; then
    systemctl is-active --quiet ollama && ok "Ollama running" || warn "Ollama service is not running"
fi

if command -v checkupdates >/dev/null; then
    n=$(checkupdates 2>/dev/null | wc -l)
    [ "$n" -lt 50 ] && ok "$n updates waiting" || warn "$n updates waiting (run: sysupdate)"
fi

n=$(git -C "$REPO" status --porcelain 2>/dev/null | wc -l)
[ "$n" -eq 0 ] && ok "dotfiles committed" || warn "$n uncommitted changes in $REPO"
if git -C "$REPO" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    n=$(git -C "$REPO" log --oneline '@{u}'..HEAD | wc -l)
    [ "$n" -eq 0 ] && ok "dotfiles pushed" || warn "$n commits not pushed (run: git -C $REPO push)"
fi
"$REPO/bin/theme-build" --check >/dev/null 2>&1 && ok "theme files match the palette" \
    || warn "theme files are out of date or hold color values (run: theme-build --check)"
"$REPO/bin/link" --check >/dev/null 2>&1 && ok "dotfiles links correct" || warn "dotfiles links are wrong (run: link --check, then link)"

# Boot: GRUB must be first, or the laptop starts Windows directly (Windows updates can change this)
boot=$(efibootmgr 2>/dev/null)
grub=$(echo "$boot" | sed -n 's/^Boot\([0-9A-F]\{4\}\)\* GRUB.*/\1/p' | head -1)
if [ -n "$grub" ]; then
    order=$(echo "$boot" | awk '/^BootOrder/ {print $2}')
    [ "${order%%,*}" = "$grub" ] && ok "GRUB is first in the boot order" \
        || warn "GRUB is not first in the boot order (fix: sudo efibootmgr -o $grub,$(echo ",$order," | sed "s/,$grub,/,/" | sed 's/^,//; s/,$//'))"
fi
if has grub-btrfs; then
    grep -qs 'grub-btrfs-overlayfs' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf && ok "snapshots can boot (overlayfs hook)" \
        || warn "snapshot boot hook missing in /etc/mkinitcpio.conf and mkinitcpio.conf.d"
fi

# pacman keeps a changed config file and writes the new package version beside it: merge with pacdiff
new=$(find /etc -xdev \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null | tr '\n' ' ')
[ -z "$new" ] && ok "no .pacnew files" || warn "config files to merge: $new(run: sudo DIFFPROG='git diff --no-index' pacdiff)"

# The copies in system/etc must match /etc, or a change on one side is lost (files only root can read are skipped)
drift=()
while IFS= read -r -d '' f; do
    live=/etc/${f#"$REPO/system/etc/"}
    [ -r "$live" ] || [ ! -e "$live" ] || continue
    cmp -s "$f" "$live" || drift+=("$live")
done < <(find "$REPO/system/etc" \( -type f -o -type l \) -print0)
[ ${#drift[@]} -eq 0 ] && ok "system/etc matches /etc" \
    || warn "system/etc and /etc differ: ${drift[*]} (compare, then copy the correct side)"

# ClamAV: the daily signature update must be on, and the signatures at most 3 days old
if has clamav; then
    systemctl -q is-enabled clamav-freshclam-once.timer 2>/dev/null && ok "virus signature update timer on" \
        || warn "virus signature update timer off (run: sudo systemctl enable --now clamav-freshclam-once.timer)"
    sig=$(stat -c %Y /var/lib/clamav/daily.cvd /var/lib/clamav/daily.cld 2>/dev/null | sort -n | tail -1)
    if [ -z "$sig" ]; then
        warn "no virus signatures (run: sudo freshclam)"
    else
        days=$(( ($(date +%s) - sig) / 86400 ))
        [ "$days" -le 3 ] && ok "virus signatures ${days} days old" || warn "virus signatures are ${days} days old"
    fi
    # Files that Companion's virus scan moved away (records.json is the list, not a file)
    q=$(find ~/.local/share/companion/quarantine -type f ! -name records.json 2>/dev/null | wc -l)
    [ "$q" -eq 0 ] && ok "virus quarantine empty" \
        || warn "$q file(s) in the virus quarantine (ask Companion to list them, then restore or delete)"
fi

if [ "$1" = "--notify" ] && [ ${#problems[@]} -gt 0 ]; then
    notify-send -a "Health check" -u normal "Health check: ${#problems[@]} problem(s)" "$(printf '%s\n' "${problems[@]}")"
fi
[ ${#problems[@]} -eq 0 ]
