#!/bin/sh
# Make see-through copies of the art cards for the desktop widget and fastfetch.
# White parts (light, low saturation) get about 50% opacity; colored parts stay at about 95%.
# Copies go to ~/.cache/art-cards as PNG; a card is redone only when the original is newer.
SRC="$HOME/Pictures/art-cards"
OUT="$HOME/.cache/art-cards"
mkdir -p "$OUT"
for card in "$SRC"/*.png "$SRC"/*.jpg "$SRC"/*.jpeg "$SRC"/*.webp; do
    [ -f "$card" ] || continue
    name=$(basename "$card")
    soft="$OUT/${name%.*}.png"
    [ "$soft" -nt "$card" ] && continue
    magick "$card" -alpha set -channel A \
        -fx "0.95 - 0.45 * clamp((lightness - 0.55) / 0.4) * (1 - saturation)" \
        +channel "$soft"
done
