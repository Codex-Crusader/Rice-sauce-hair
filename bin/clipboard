#!/bin/sh
# Clipboard history: select an entry with Rofi, then copy it again.
# Esc in Rofi changes nothing (an empty pipe into wl-copy would clear the clipboard).
choice=$(cliphist list | rofi -dmenu -i -p "Clipboard") || exit 0
[ -n "$choice" ] || exit 0
printf '%s\n' "$choice" | cliphist decode | wl-copy
