// fastfetch, theme "Amphora". Shown when a Kitty window opens (see shell/zshrc).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Fallback logo: the Arch logo in gold. New Kitty windows pass a random card instead (shell/zshrc).
    "logo": {
        "source": "arch_small",
        "color": { "1": "38;2;201;161;91", "2": "38;2;201;161;91" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;201;161;91", "title": "38;2;200;168;235" },
        "key": { "width": 13 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}  ·  Amphoreus" },
        { "type": "custom", "format": "\u001b[38;2;201;161;91m────────────────────────────\u001b[0m" },
        { "type": "os",       "key": "  os" },
        { "type": "kernel",   "key": "  kernel" },
        { "type": "wm",       "key": "  wm" },
        { "type": "packages", "key": "󰏖  pkgs" },
        { "type": "uptime",   "key": "󰅐  uptime" },
        { "type": "cpu",      "key": "  cpu", "format": "{name}" },
        // pci only: other methods can wake the sleeping NVIDIA GPU
        { "type": "gpu",      "key": "󰢮  gpu", "detectionMethod": "pci", "driverSpecific": false, "format": "{name}" },
        { "type": "memory",   "key": "󰍛  ram" },
        { "type": "disk",     "key": "󰋊  disk", "folders": "/" },
        { "type": "battery",  "key": "󰁹  battery" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
