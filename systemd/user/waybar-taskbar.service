[Unit]
Description=Taskbar (Waybar)
PartOf=hypr-desktop.target
After=hypr-desktop.target
# Stop trying after 5 failures in 60 s, so a broken part cannot loop forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/waybar -c %h/.config/waybar/taskbar.jsonc -s %h/.config/waybar/taskbar.css
Restart=on-failure
RestartSec=2

