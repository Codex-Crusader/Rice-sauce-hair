[Unit]
Description=Castorice, the desktop companion
PartOf=hypr-desktop.target
After=hypr-desktop.target
# Stop trying after 5 failures in 60 s, so a broken part cannot loop forever
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/dotfiles/companion/castorice
Restart=on-failure
RestartSec=2

